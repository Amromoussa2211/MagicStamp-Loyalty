{
  "name": "android-test-automation",
  "version": "1.0.0",
  "description": "Test automation framework for Android apps using WebdriverIO and Appium.",
  "main": "index.js",
  "scripts": {
    "test": "wdio run ./wdio.conf.js",
    "test:local": "rm -rf allure-results; for f in test/specs/*.spec.js; do wdio run ./wdio.local.conf.js --spec \"$f\" || true; done; npm run generate-report; npm run open-report",
    "test:ci": "wdio run ./wdio.ci.conf.js",
    "generate-report": "allure generate allure-results --clean -o allure-report",
    "open-report": "node_modules/.bin/allure open allure-report",
    "test:web": "playwright test",
    "test:web:setup": "playwright install chromium",
    "test:all": "rm -rf allure-results; for f in test/specs/*.spec.js; do wdio run ./wdio.local.conf.js --spec \"$f\" || true; done; node scripts/allure-fallback.js; npm run test:web; npm run generate-report; npm run open-report",
    "start:appium": "appium",
    "device:discover": "node scripts/device/discover.js",
    "device:apk": "node scripts/device/apk-info.js",
    "device:compat": "node scripts/device/check-compat.js",
    "device:probe": "node scripts/device/probe.js",
    "device:evidence": "node scripts/device/evidence.js",
    "device:emulator": "node scripts/device/emulator.js",
    "device:emulator:stop": "node scripts/device/emulator.js --stop"
  },
  "dependencies": {
    "@faker-js/faker": "^7.6.0",
    "@wdio/allure-reporter": "latest",
    "@wdio/cli": "^9.4.5",
    "axios": "^1.8.4",
    "chai": "^4.3.6",
    "dotenv": "^16.4.7",
    "eslint": "latest",
    "node-fetch": "^3.3.2",
    "webdriverio": "latest"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@wdio/appium-service": "^9.4.5",
    "@wdio/browserstack-service": "^9.5.2",
    "@wdio/local-runner": "^9.4.5",
    "@wdio/mocha-framework": "^9.4.4",
    "@wdio/spec-reporter": "^9.4.4",
    "allure-commandline": "^2.24.0",
    "allure-playwright": "^2.15.1",
    "appium": "^2.13.1",
    "appium-uiautomator2-driver": "^3.9.8"
  },
  "keywords": [
    "appium",
    "webdriverio",
    "android",
    "automation",
    "testing"
  ],
  "author": "Your Name",
  "license": "ISC",
  "packageManager": "pnpm@9.15.0+sha512.76e2379760a4328ec4415815bcd6628dee727af3779aaa4c914e3944156c4299921a89f976381ee107d41f12cfa4b66681ca9c718f0668fa0831ed4c6d8ba56c"
}
