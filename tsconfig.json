{
  "compilerOptions": {
    "target": "ES2021",
    "module": "commonjs",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "strict": true,
    "skipLibCheck": true,
    "outDir": "dist",
    "rootDir": ".",
    "types": ["mocha", "node", "chai"]
  },
  "include": ["**/*.ts", "wdio.conf.js"],
  "exclude": ["node_modules", "reports", "dist", "logs", "allure-results", "allure-report"]
}
